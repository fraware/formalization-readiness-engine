# Copy to .env for local development.
# Never commit real credentials.

# OpenAI (required for live extraction and demo-live)
OPENAI_API_KEY=
FRE_MODEL_NAME=gpt-4.1

# Artifact and job storage (local defaults)
FRE_ARTIFACT_DIR=artifacts/generated
FRE_JOBS_DB=artifacts/generated/jobs.db

# Redis/RQ (Docker Compose sets redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Set to 1 to run async jobs in-process without Redis (local API dev only)
FRE_JOBS_INLINE=0

# Review write path (disabled by default)
FRE_REVIEW_WRITE_ENABLED=0

# Retry limit for extraction jobs
FRE_MAX_RETRIES=3

# Demo: set to 1 to skip Lean checking (CI uses this)
# DEMO_SKIP_LEAN=1
